        <ignore path="res/mipmap-anydpi-v26" />
    </issue>

    <!-- AGP 9.x is not a real/public stable release. The reported "9.3.2" does not exist. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />

    <!-- Lint's dependency database suggests preview/future versions (e.g. Compose BOM 2026.08.00)
         that are not available. Suppress informational update nudges; versions are managed manually. -->
    <issue id="GradleDependency" severity="ignore" />
</lint>
